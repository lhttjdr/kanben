\begin{quote}
「玼兮玼兮，其之\rhyme[ru,1]{翟}也。鬒髮如雲，不屑\rhyme[qu,1]{髢}也。揚且〪之\rhyme[ru,2]{皙}也。胡然\rhyme[ping]{天}也。」
\end{quote}

\begin{quote}
「\ruby[◓]{鳳}\ruby[○]{凰}\ruby[◒]{山}\ruby[●]{下}\ruby[●]{雨}\ruby[○]{初}\ruby[○]{晴}，\ruby[●]{水}\ruby[○]{風}\ruby[○]{清}。」
\end{quote}

\begin{quote}
\pitch[清黃]{呦}\pitch[南]{呦}\pitch[蕤]{鹿}\pitch[姑]{鳴}。\pitch[南]{食}\pitch[姑]{野}\pitch[清蔟]{之}\pitch[黃, left]{苹}。
